{
  "packages": [
    "npm:pi-provider-litellm",
    "npm:pi-mcp-adapter",
    "npm:pi-forgejo-toolkit",
    "npm:pi-tavily-tools"
  ],
  "defaultProvider": "litellm-chat",
  "enabledModels": ["litellm-chat/*", "litellm/*"],
  "defaultModel": "weak-fallback-chain",
  "litellm": {
    "providers": {
      "litellm": {
        "baseUrl": "http://skyloft.tailb6874b.ts.net:4000",
        "apiKey": "$LITELLM_API_KEY",
        "allowInsecureHttp": true
      }
    }
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3
  }
}